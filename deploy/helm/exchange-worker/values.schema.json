{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "database": {
      "type": "object",
      "required": [
        "name",
        "user",
        "port",
        "secret"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "secret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "imageRegistry": {
      "type": "string",
      "minLength": 1
    },
    "imagePullPolicy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "valueFrom"
            ]
          }
        ]
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectorImage": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "collectorImage",
        "endpoint",
        "resources"
      ]
    }
  },
  "additionalProperties": false
}
