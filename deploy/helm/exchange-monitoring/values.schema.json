{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "database": {
      "type": "object",
      "required": [
        "name",
        "user",
        "port",
        "secret"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "secret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "retentionTime": {
          "type": "string"
        },
        "retentionSize": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "image": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "grafana": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "image": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        },
        "adminSecret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "postgresExporter": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "image": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redisExporter": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "image": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "vaultId": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "externalSecrets"
        ],
        "properties": {
          "externalSecrets": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "required": [
              "vaultId",
              "secretName"
            ],
            "properties": {
              "vaultId": {
                "minLength": 1
              },
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
