{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "maxConnections": {"type": "integer", "minimum": 100, "maximum": 1000},
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "database": {
      "type": "object",
      "required": [
        "name",
        "user",
        "port",
        "secret"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "secret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "vaultId": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "legacyKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "externalSecrets"
        ],
        "properties": {
          "externalSecrets": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "required": [
              "vaultId",
              "secretName"
            ],
            "properties": {
              "vaultId": {
                "minLength": 1
              },
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
